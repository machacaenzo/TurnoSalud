<Window x:Class="Views.Paginas.Consutas.MisPacientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Views.Paginas.Consutas"
       xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:Views.Converters"
        mc:Ignorable="d"
        Title="Mis Pacientes" Height="600" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="{StaticResource BrushPanel}" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de Título -->
            <Grid Grid.Row="0">
                <TextBlock Text="MIS PACIENTES ATENDIDOS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrimario}" Margin="20"/>
                <Button x:Name="btnClose" Content="✕" Click="btnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            </Grid>

            <!-- Contenido -->
            <StackPanel Grid.Row="1" Margin="20,0,20,20">
                <!-- Búsqueda -->
                <Grid Width="350" HorizontalAlignment="Left" Margin="0,0,0,15">
                    <TextBlock Text="Buscar pacientes por cualquier campo..." Foreground="{StaticResource BrushTextoSecundario}" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False" Panel.ZIndex="1"
                               Visibility="{Binding ElementName=txtBuscar, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox x:Name="txtBuscar" Style="{StaticResource ModernTextBox}" TextChanged="txtBuscar_TextChanged"/>
                </Grid>

                <!-- DataGrid de Pacientes -->
                <DataGrid x:Name="dgPacientes" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="*"/>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="1.5*"/>
                        <DataGridTextColumn Header="APELLIDO" Binding="{Binding Apellido}" Width="1.5*"/>
                        <DataGridTemplateColumn Header="HISTORIAL" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Ver Historial Clínico Completo" Click="btnVerHistorial_Click">
                                        <iconPacks:PackIconMaterial Kind="ClipboardListOutline" Width="16" Height="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
