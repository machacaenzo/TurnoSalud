<UserControl x:Class="Views.Paginas.Principal.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Views.Paginas.Principal"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BrushFondo}" Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Tarjetas de Totales -->
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <!-- Gráficos y Listas -->
            </Grid.RowDefinitions>

            <!-- Fila de Tarjetas de Totales -->
            <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                <Border Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="20" Margin="10">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="AccountGroup" Height="30" Width="30" Foreground="{StaticResource BrushAcento}"/>
                        <TextBlock x:Name="lblTotalPacientes" Text="0" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Pacientes Registrados" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="20" Margin="10">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="Doctor" Height="30" Width="30" Foreground="{StaticResource BrushAcento}"/>
                        <TextBlock x:Name="lblTotalMedicos" Text="0" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Médicos Activos" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="20" Margin="10">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="CalendarCheck" Height="30" Width="30" Foreground="{StaticResource BrushAcento}"/>
                        <TextBlock x:Name="lblTotalTurnosHoy" Text="0" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Turnos Atendidos Hoy" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushPanel}" CornerRadius="8" Padding="20" Margin="10">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="Dna" Height="30" Width="30" Foreground="{StaticResource BrushAcento}"/>
                        <TextBlock x:Name="lblTotalEspecialidades" Text="0" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="Especialidades Activas" Foreground="{StaticResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Fila de Listas y Gráficos -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOP 5 ESPECIALIDADES CON MÁS TURNOS" Style="{StaticResource FormLabel}" FontSize="14" Margin="10,0,0,5"/>
                    <DataGrid x:Name="dgTopEspecialidades" Style="{StaticResource ModernDataGrid}" Margin="10,0,10,20" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Especialidad" Binding="{Binding Etiqueta}" Width="*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="TOP 5 MÉDICOS CON MÁS TURNOS" Style="{StaticResource FormLabel}" FontSize="14" Margin="10,0,0,5"/>
                    <DataGrid x:Name="dgTopMedicos" Style="{StaticResource ModernDataGrid}" Margin="10,0,10,0" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Médico" Binding="{Binding Etiqueta}" Width="*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ÚLTIMOS 5 TURNOS ATENDIDOS" Style="{StaticResource FormLabel}" FontSize="14" Margin="10,0,0,5"/>
                    <DataGrid x:Name="dgUltimosTurnos" Style="{StaticResource ModernDataGrid}" Margin="10,0,10,0" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTurno, StringFormat='dd/MM/yy'}" Width="Auto"/>
                            <DataGridTextColumn Header="Paciente" Binding="{Binding NombrePaciente}" Width="*"/>
                            <DataGridTextColumn Header="Médico" Binding="{Binding NombreMedico}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
