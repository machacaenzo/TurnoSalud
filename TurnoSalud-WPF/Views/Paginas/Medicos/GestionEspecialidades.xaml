<Window x:Class="Views.Paginas.Medicos.GestionEspecialidades"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Views.Paginas.Medicos"
          xmlns:converters="clr-namespace:Views.Converters"
        mc:Ignorable="d"
        Title="Gestión de Especialidades" Height="500" Width="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:BoolToEstadoConverter x:Key="BoolToEstadoConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="{StaticResource BrushPanel}" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Barra de Título -->
                <RowDefinition Height="*"/>
                <!-- Contenido Principal -->
                <RowDefinition Height="Auto"/>
                <!-- Botones de Acción -->
            </Grid.RowDefinitions>

            <!-- 1. Barra de Título -->
            <Grid Grid.Row="0">
                <TextBlock Text="GESTIÓN DE ESPECIALIDADES" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrimario}" Margin="20"/>
                <Button x:Name="btnClose" Content="✕" Width="30" Height="30" Click="btnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="{StaticResource BrushTextoSecundario}"/>
            </Grid>

            <!-- 2. Contenido Principal (Dos Columnas) -->
            <Grid Grid.Row="1" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Lista de Especialidades -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="LISTA DE ESPECIALIDADES" Style="{StaticResource FormLabel}" FontSize="14"/>
                        <Grid Width="Auto" HorizontalAlignment="Stretch" Margin="0,5,0,0">
                            <TextBlock Text="Buscar por nombre..." Foreground="{StaticResource BrushTextoSecundario}" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False" Panel.ZIndex="1"
                                       Visibility="{Binding ElementName=txtBuscar, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBox x:Name="txtBuscar" Style="{StaticResource ModernTextBox}" TextChanged="txtBuscar_TextChanged"/>
                        </Grid>
                        <CheckBox x:Name="chkMostrarInactivos" Content="Mostrar Inactivos" Margin="0,10,0,10" Checked="chkMostrarInactivos_CheckedChanged" Unchecked="chkMostrarInactivos_CheckedChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="dgEspecialidades" Grid.Row="1" Style="{StaticResource ModernDataGrid}" SelectionChanged="dgEspecialidades_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado, Converter={StaticResource BoolToEstadoConverter}}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Columna Derecha: Formulario de Datos -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="DATOS DE LA ESPECIALIDAD" Style="{StaticResource FormLabel}" FontSize="14" Margin="0,0,0,20"/>
                    <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtNombre" Style="{StaticResource FormTextBox}"/>
                </StackPanel>
            </Grid>

            <!-- 3. Botones de Acción Inferiores -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                <Button x:Name="btnNuevo" Content="Nuevo" Style="{StaticResource PrimaryButton}" Click="btnNuevo_Click" MinWidth="100"/>
                <Button x:Name="btnEditar" Content="Editar" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="btnEditar_Click" MinWidth="100"/>
                <Button x:Name="btnEliminar" Content="Eliminar" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="btnEliminar_Click" MinWidth="100"/>
                <Button x:Name="btnGuardar" Content="Guardar" Style="{StaticResource SuccessButton}" Margin="10,0,0,0" Click="btnGuardar_Click" MinWidth="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
