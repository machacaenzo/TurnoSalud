<Page x:Class="Views.Paginas.EstacionAutogestion.Bienvenida"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Views.Paginas.EstacionAutogestion"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Bienvenida"
      Background="{StaticResource BrushFondo}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <iconPacks:PackIconMaterial Kind="Handshake" Foreground="{StaticResource BrushAcento}" 
                                        Width="80" Height="80" HorizontalAlignment="Center"/>

            <TextBlock Text="¡BIENVENIDO!" FontSize="80" FontWeight="Bold"
                       Foreground="{StaticResource BrushAcento}" Margin="0,20,0,0"/>

            <TextBlock Text="AGENDA TUS TURNOS AQUÍ" FontSize="30" 
                       Foreground="{StaticResource BrushTextoSecundario}" Margin="0,10,0,0"/>

            <Button x:Name="btnIngresar" Style="{StaticResource PrimaryButton}" 
                    Padding="40,15" Margin="0,50,0,0" Click="btnIngresar_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="INGRESAR" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <iconPacks:PackIconMaterial Kind="ArrowRight" Width="24" Height="24" 
                                                VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
