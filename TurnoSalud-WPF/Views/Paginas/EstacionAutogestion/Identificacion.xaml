<Page x:Class="Views.Paginas.EstacionAutogestion.Identificacion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Views.Paginas.EstacionAutogestion"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:converters="clr-namespace:Views.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Identificacion"
      Background="{StaticResource BrushFondo}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">

        <iconPacks:PackIconMaterial Kind="Handshake" Foreground="{StaticResource BrushAcento}" 
                                    Width="40" Height="40" HorizontalAlignment="Center"/>
        <TextBlock Text="AGENDA TUS TURNOS AQUÍ" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextoPrimario}" Margin="0,10,0,0" HorizontalAlignment="Center"/>

        <TextBlock Text="PARA CONTINUAR, INGRESA TU DNI" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource BrushAcento}" Margin="0,40,0,0" HorizontalAlignment="Center"/>
        <TextBlock Text="SIN PUNTOS" FontSize="14" Foreground="{StaticResource BrushTextoSecundario}" HorizontalAlignment="Center"/>

        <!-- Contenedor para el TextBox de DNI con placeholder -->
        <Grid Width="300" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBlock Text="DNI" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"
                       Foreground="{StaticResource BrushTextoSecundario}" IsHitTestVisible="False"
                       Visibility="{Binding ElementName=txtDni, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox x:Name="txtDni" Style="{StaticResource FormTextBox}" FontSize="20" TextAlignment="Center" TextChanged="txtDni_TextChanged"/>
        </Grid>
        <TextBlock x:Name="errDni" Style="{StaticResource FormErrorLabel}" HorizontalAlignment="Center"/>

        <StackPanel x:Name="pnlNuevosDatos" Visibility="Collapsed" Margin="0,40,0,0">
            <TextBlock Text="PARECE QUE ERES NUEVO, INGRESA TUS DATOS" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource BrushAcento}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="SOLO LO HAREMOS LA PRIMERA VEZ" FontSize="14" Foreground="{StaticResource BrushTextoSecundario}" HorizontalAlignment="Center"/>

            <!-- CAMPO NOMBRE CON LABEL -->
            <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}" Margin="0,20,0,5" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtNombre" Style="{StaticResource FormTextBox}" Width="300" HorizontalAlignment="Center" FontSize="20" TextAlignment="Center"/>
            <TextBlock x:Name="errNombre" Style="{StaticResource FormErrorLabel}" HorizontalAlignment="Center"/>

            <!-- CAMPO APELLIDO CON LABEL -->
            <TextBlock Text="APELLIDO" Style="{StaticResource FormLabel}" Margin="0,10,0,5" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtApellido" Style="{StaticResource FormTextBox}" Width="300" HorizontalAlignment="Center" FontSize="20" TextAlignment="Center"/>
            <TextBlock x:Name="errApellido" Style="{StaticResource FormErrorLabel}" HorizontalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="btnSiguiente" Style="{StaticResource PrimaryButton}" 
                Padding="30,12" Margin="0,40,0,0" Click="btnSiguiente_Click" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SIGUIENTE" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <iconPacks:PackIconMaterial Kind="ArrowRight" Width="20" Height="20" 
                                            VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Button>
    </StackPanel>
</Page>
