<Page x:Class="Views.Paginas.EstacionAutogestion.Confirmacion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Views.Paginas.EstacionAutogestion"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Confirmacion"
      Background="{StaticResource BrushFondo}"
      Loaded="Page_Loaded">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="700">
            <iconPacks:PackIconMaterial Kind="Handshake" Foreground="{StaticResource BrushAcento}" 
                                        Width="40" Height="40" HorizontalAlignment="Center"/>
            <TextBlock Text="AGENDA TUS TURNOS AQUÍ" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextoPrimario}" Margin="0,10,0,30" HorizontalAlignment="Center"/>

            <Border Background="{StaticResource BrushPanel}" CornerRadius="10" Padding="40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DATOS DEL TURNO A CONFIRMAR" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAcento}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <!-- Panel de Resumen -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PACIENTE:" Style="{StaticResource FormLabel}" FontSize="16" Margin="0,0,15,15"/>
                        <TextBlock x:Name="lblResumenPaciente" Grid.Row="0" Grid.Column="1" FontSize="16" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MÉDICO:" Style="{StaticResource FormLabel}" FontSize="16" Margin="0,0,15,15"/>
                        <TextBlock x:Name="lblResumenMedico" Grid.Row="1" Grid.Column="1" FontSize="16" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="DÍA:" Style="{StaticResource FormLabel}" FontSize="16" Margin="0,0,15,15"/>
                        <TextBlock x:Name="lblResumenDia" Grid.Row="2" Grid.Column="1" FontSize="16" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="HORA INICIO:" Style="{StaticResource FormLabel}" FontSize="16" Margin="0,0,15,15"/>
                        <TextBlock x:Name="lblResumenHoraInicio" Grid.Row="3" Grid.Column="1" FontSize="16" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="HORA FIN:" Style="{StaticResource FormLabel}" FontSize="16" Margin="0,0,15,15"/>
                        <TextBlock x:Name="lblResumenHoraFin" Grid.Row="4" Grid.Column="1" FontSize="16" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="FECHA:" Style="{StaticResource FormLabel}" FontSize="16" Margin="0,0,15,15"/>
                        <TextBlock x:Name="lblResumenFecha" Grid.Row="5" Grid.Column="1" FontSize="16" Margin="0,0,0,15"/>
                    </Grid>

                    <!-- Botones -->
                    <Grid Grid.Row="2" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnVolver" Grid.Column="0" Style="{StaticResource PrimaryButton}" Background="{StaticResource BrushTextoSecundario}"
                                Padding="30,12" HorizontalAlignment="Left" Click="btnVolver_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="VOLVER" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnConfirmar" Grid.Column="1" Style="{StaticResource SuccessButton}" 
                                Padding="30,12" HorizontalAlignment="Right" Click="btnConfirmar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CONFIRMAR" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <iconPacks:PackIconMaterial Kind="Check" Width="20" Height="20" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
