<Page x:Class="Views.Paginas.EstacionAutogestion.Comprobante"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Views.Paginas.EstacionAutogestion"
     xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Comprobante"
      Background="{StaticResource BrushFondo}"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Columna Central para el Comprobante -->
        <Border Grid.Column="1" Background="{StaticResource BrushPanel}" CornerRadius="10" 
                Width="500" MinHeight="600" Padding="30" VerticalAlignment="Center"
                >

            <StackPanel>
                <iconPacks:PackIconMaterial Kind="CheckDecagram" Foreground="#28A745" Width="50" Height="50" HorizontalAlignment="Center"/>
                <TextBlock Text="TURNO CONFIRMADO" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrimario}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                <TextBlock Text="Guarde este comprobante para su registro." Foreground="{StaticResource BrushTextoSecundario}" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                <Border BorderBrush="{StaticResource BrushBordeSutil}" BorderThickness="0,1,0,1" Padding="0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PACIENTE:" Style="{StaticResource FormLabel}" FontSize="14"/>
                        <TextBlock x:Name="lblPaciente" Grid.Row="0" Grid.Column="1" FontSize="14" Margin="10,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MÉDICO:" Style="{StaticResource FormLabel}" FontSize="14"/>
                        <TextBlock x:Name="lblMedico" Grid.Row="1" Grid.Column="1" FontSize="14" Margin="10,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ESPECIALIDAD:" Style="{StaticResource FormLabel}" FontSize="14"/>
                        <TextBlock x:Name="lblEspecialidad" Grid.Row="2" Grid.Column="1" FontSize="14" Margin="10,0,0,10"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="FECHA:" Style="{StaticResource FormLabel}" FontSize="14"/>
                        <TextBlock x:Name="lblFecha" Grid.Row="3" Grid.Column="1" FontSize="14" Margin="10,0,0,10"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="HORARIO:" Style="{StaticResource FormLabel}" FontSize="14"/>
                        <TextBlock x:Name="lblHorario" Grid.Row="4" Grid.Column="1" FontSize="14" Margin="10,0,0,10"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="TURNO:" Style="{StaticResource FormLabel}" FontSize="14"/>
                        <TextBlock x:Name="lblBloque" Grid.Row="5" Grid.Column="1" FontSize="14" Margin="10,0,0,10"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Columna Derecha para Botones de Acción -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="40,0,0,0">
            <Button x:Name="btnGuardarPdf" Style="{StaticResource PrimaryButton}" Padding="20,12" Margin="0,0,0,15" Click="btnGuardarPdf_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="GUARDAR PDF" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnMisTurnos" Style="{StaticResource PrimaryButton}" Padding="20,12" Margin="0,0,0,15" Click="btnMisTurnos_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CalendarAccount" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="MIS TURNOS" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnFinalizar" Style="{StaticResource SuccessButton}" Padding="20,12" Margin="0,30,0,15" Click="btnFinalizar_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="FINALIZAR" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
