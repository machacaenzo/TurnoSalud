<Window x:Class="Views.Paginas.Pacientes.GestionPacientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Views.Paginas.Pacientes"
        mc:Ignorable="d"
         Title="Gestión de Paciente" Height="350" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">

    <Border Background="{StaticResource BrushPanel}" CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="1" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Título -->
                <RowDefinition Height="*"/>
                <!-- Formulario -->
                <RowDefinition Height="Auto"/>
                <!-- Botón Guardar -->
            </Grid.RowDefinitions>

            <!-- Barra de Título -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="lblTitulo" Text="NUEVO PACIENTE" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrimario}" Margin="20"/>
                <Button x:Name="btnClose" Content="✕" Click="btnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            </Grid>

            <!-- Formulario -->
            <Grid Grid.Row="1" Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DNI" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtDni" Style="{StaticResource FormTextBox}"/>
                    <TextBlock x:Name="errDni" Style="{StaticResource FormErrorLabel}" Visibility="Collapsed"/>

                    <TextBlock Text="APELLIDO" Style="{StaticResource FormLabel}" Margin="0,15,0,5"/>
                    <TextBox x:Name="txtApellido" Style="{StaticResource FormTextBox}"/>
                    <TextBlock x:Name="errApellido" Style="{StaticResource FormErrorLabel}" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtNombre" Style="{StaticResource FormTextBox}"/>
                    <TextBlock x:Name="errNombre" Style="{StaticResource FormErrorLabel}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Botón Guardar -->
            <Button x:Name="btnGuardar" Grid.Row="2" Content="Guardar" Style="{StaticResource SuccessButton}" Height="40" Margin="20" Click="btnGuardar_Click"/>
        </Grid>
    </Border>
</Window>
