<Window x:Class="Views.Notificaciones.Notificacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Views.Notificaciones"
         xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Notificacion" Height="250" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">

    <Border CornerRadius="10" Background="{StaticResource BrushPanel}" BorderBrush="#CCCCCC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Panel Superior de Color -->
            <Border x:Name="HeaderBorder" Grid.Row="0" CornerRadius="10,10,0,0" Background="Gray">
                <Viewbox Width="50" Height="50">
                    <iconPacks:PackIconMaterial x:Name="Icono" Kind="Help" Foreground="White"/>
                </Viewbox>
            </Border>

            <!-- Panel Inferior con Mensaje y Botones -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20">
                <TextBlock x:Name="txtMensaje" Text="MENSAJE" HorizontalAlignment="Center" 
                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrimario}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="txtSubtitulo" Text="Subtítulo del mensaje" HorizontalAlignment="Center" 
                           Margin="0,5,0,20" Foreground="{StaticResource BrushTextoSecundario}"
                           Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnAceptar" Content="Aceptar" Click="btnAceptar_Click" MinWidth="100" Margin="5"/>
                    <Button x:Name="btnCancelar" Content="Cancelar" Click="btnCancelar_Click" MinWidth="100" Margin="5" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>

</Window>
