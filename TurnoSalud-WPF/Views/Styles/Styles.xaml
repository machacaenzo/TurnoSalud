<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">


    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Estilo para los botones del menú de navegación (RadioButton) -->
    <Style x:Key="MenuButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <!-- Fondo normal transparente sobre el verde del sidebar -->
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSobrePrimario}"/>
        <!-- Texto blanco -->
        <Setter Property="Padding" Value="20,15"/>
        <Setter Property="Margin" Value="15,5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Cuando el mouse está sobre el botón (y NO está activo) -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushPrimarioHover}"/>
            </Trigger>
            <!-- Cuando el botón está seleccionado (activo) -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushBotonActivo}"/>
                <!-- Fondo BLANCO -->
                <Setter Property="Foreground" Value="{StaticResource BrushTextoEnBotonActivo}"/>
                <!-- Texto VERDE -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para los íconos del menú -->
    <Style x:Key="MenuButtonIcon" TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,15,0"/>
    </Style>

    <!-- Estilo para el Botón Primario (ej. "NUEVO USUARIO") -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAcento}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSobreAcento}"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAcentoActivo}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para el TextBox de Búsqueda -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeSutil}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoPrimario}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para las CELDAS del DataGrid (CORREGIDO) -->
    <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Cuando la celda está dentro de una fila seleccionada -->
            <Trigger Property="IsSelected" Value="True">
                <!-- Hacemos el fondo de la celda TRANSPARENTE -->
                <Setter Property="Background" Value="Transparent"/>
                <!-- Ponemos el texto en blanco para que sea legible sobre el fondo verde de la fila -->
                <Setter Property="Foreground" Value="{StaticResource BrushTextoSobrePrimario}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para las FILAS del DataGrid -->
    <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHoverFila}"/>
                <!-- USANDO EL NUEVO BRUSH -->
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAcento}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para las CABECERAS de las columnas -->
    <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeSutil}"/>
        <Setter Property="Padding" Value="10,12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoPrimario}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- Estilo PRINCIPAL del DataGrid -->
    <Style x:Key="ModernDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeSutil}"/>
        <Setter Property="RowHeight" Value="45"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CellStyle" Value="{StaticResource ModernDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRow}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernDataGridColumnHeader}"/>
    </Style>

    <!-- Estilo para los botones con ícono DENTRO del DataGrid (CORREGIDO) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
        <!-- Color por defecto (gris) -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Efecto hover para el botón de editar -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushEditarHoverFondo}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushEditarHoverIcono}"/>
            </Trigger>

            <!-- ESTA ES LA NUEVA REGLA -->
            <!-- Cuando el botón está dentro de una fila seleccionada (IsSelected = True) -->
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <!-- Cambiamos el color del ícono a BLANCO -->
                <Setter Property="Foreground" Value="{StaticResource BrushTextoSobrePrimario}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para el botón de eliminar (hereda del anterior y añade la misma regla) -->
    <Style x:Key="IconButtonDelete" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <!-- Efecto hover (se mantiene como estaba) -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushEliminarHoverFondo}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushEliminarHoverIcono}"/>
            </Trigger>

            <!-- AÑADIMOS LA MISMA REGLA AQUÍ -->
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushTextoSobrePrimario}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para Botón de Éxito (Verde) -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#28A745"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#218838"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilo para Botón de Peligro/Cancelar (Rojo) -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#DC3545"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C82333"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Estilo para las etiquetas (TextBlock) de los formularios -->
    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- Estilo base para los TextBoxes del formulario (hereda de ModernTextBox) -->
    <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Estilo para el PasswordBox del formulario -->
    <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeSutil}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoPrimario}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para el ComboBox de Roles -->
    <Style x:Key="FormComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeSutil}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoPrimario}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- Estilo para el DatePicker -->
    <Style x:Key="FormDatePicker" TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeSutil}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoPrimario}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    
    
    <Style x:Key="FormErrorLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
        <!-- Usa el color rojo de error que ya definiste -->
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>


    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="140"/>
    </Style>
</ResourceDictionary>