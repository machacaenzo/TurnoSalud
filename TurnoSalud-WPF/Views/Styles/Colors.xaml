<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    <Color x:Key="ColorPrimario">#0097A7</Color>
    <Color x:Key="ColorPrimarioResaltado">#00838F</Color>
    <Color x:Key="ColorBotonActivoFondo">#FFFFFF</Color>
    <Color x:Key="ColorFondoGeneral">#F5F7FA</Color>
    <Color x:Key="ColorPanel">#FFFFFF</Color>
    <Color x:Key="ColorTextoPrincipal">#263238</Color>
    <Color x:Key="ColorTextoSecundario">#78909C</Color>
    <Color x:Key="ColorTextoSobrePrimario">#FFFFFF</Color>
    <Color x:Key="ColorBorde">#CFD8DC</Color>
    <Color x:Key="ColorHoverFila">#E6F4F6</Color>
    <Color x:Key="ColorEditarFondo">#DDF0FF</Color>
    <Color x:Key="ColorEditarIcono">#007ACC</Color>
    <Color x:Key="ColorEliminarFondo">#FFDDE2</Color>
    <Color x:Key="ColorEliminarIcono">#D32F2F</Color>
    <Color x:Key="ColorError">#D32F2F</Color>

    
    <SolidColorBrush x:Key="BrushPrimario" Color="{StaticResource ColorPrimario}"/>
    <SolidColorBrush x:Key="BrushPrimarioHover" Color="{StaticResource ColorPrimarioResaltado}"/>
    <SolidColorBrush x:Key="BrushBotonActivo" Color="{StaticResource ColorBotonActivoFondo}"/>
    <SolidColorBrush x:Key="BrushTextoEnBotonActivo" Color="{StaticResource ColorPrimario}"/>

    <!-- Fondos y Paneles -->
    <SolidColorBrush x:Key="BrushFondo" Color="{StaticResource ColorFondoGeneral}"/>
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="BrushBordeSutil" Color="{StaticResource ColorBorde}"/>

    <!-- Textos -->
    <SolidColorBrush x:Key="BrushTextoPrimario" Color="{StaticResource ColorTextoPrincipal}"/>
    <SolidColorBrush x:Key="BrushTextoSecundario" Color="{StaticResource ColorTextoSecundario}"/>
    <SolidColorBrush x:Key="BrushTextoSobrePrimario" Color="{StaticResource ColorTextoSobrePrimario}"/>

    <!-- DataGrid y Estados -->
    <SolidColorBrush x:Key="BrushHoverFila" Color="{StaticResource ColorHoverFila}"/>
    <SolidColorBrush x:Key="BrushAcento" Color="{StaticResource ColorPrimario}"/>
    <SolidColorBrush x:Key="BrushAcentoActivo" Color="{StaticResource ColorPrimarioResaltado}"/>
    <SolidColorBrush x:Key="BrushTextoSobreAcento" Color="{StaticResource ColorTextoSobrePrimario}"/>

    <!-- Botones de Acción en DataGrid -->
    <SolidColorBrush x:Key="BrushEditarHoverFondo" Color="{StaticResource ColorEditarFondo}"/>
    <SolidColorBrush x:Key="BrushEditarHoverIcono" Color="{StaticResource ColorEditarIcono}"/>
    <SolidColorBrush x:Key="BrushEliminarHoverFondo" Color="{StaticResource ColorEliminarFondo}"/>
    <SolidColorBrush x:Key="BrushEliminarHoverIcono" Color="{StaticResource ColorEliminarIcono}"/>
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}"/>

</ResourceDictionary>